# Copy to .env or export as environment variables
# Never commit real credentials

# Supabase PostgreSQL - get from Supabase Dashboard > Database > Connection string
# Example: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/flight_tracking
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Server port (Render sets PORT automatically)
PORT=8080

# JWT - MUST be Base64-encoded and at least 256 bits (32 bytes)
# Generate with: openssl rand -base64 32
# Default in application.yml is for local dev only; set a strong unique value in production!
JWT_SECRET=bXktdmVyeS1sb25nLWRldi1qd3Qtc2VjcmV0LWtleS10aGF0LWlzLTMyLWJ5dGVzISE=
JWT_EXPIRATION_MS=86400000

# AeroDataBox - Primary flight data provider (via API.Market)
# Get key at: https://apimarket.aerodatabox.com/
AERODATABOX_API_KEY=your_aerodatabox_api_market_key_here
AERODATABOX_BASE_URL=https://prod.api.market/api/v1/aedbx/aerodatabox
AERODATABOX_TIMEOUT_MS=10000

# OpenSky Network - Live ADS-B telemetry (OAuth2 client credentials)
# Register at: https://opensky-network.org → My OpenSky → Create API client
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_CLIENT_ID=your_opensky_client_id_here
OPENSKY_CLIENT_SECRET=your_opensky_client_secret_here
OPENSKY_TIMEOUT_MS=10000

# Open-Meteo - Weather (https://open-meteo.com) - No API key required, free
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_TIMEOUT_MS=5000

# CORS - allowed origins for React frontend (comma-separated)
# Local dev default: http://localhost:3000,http://localhost:5173
# Production: set to deployed frontend URL, e.g. https://your-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Spring profile
# SPRING_PROFILES_ACTIVE=dev
# For production on Render: SPRING_PROFILES_ACTIVE=prod

AIRLABS_API_KEY=

# Ignav - Flight search and booking links (used by Booking page)
# Get key at: https://ignav.com or your Ignav provider
IGNAV_API_KEY=your_ignav_api_key_here
IGNAV_BASE_URL=https://api.ignav.com
IGNAV_TIMEOUT_MS=10000

AI_SERVICE_BASE_URL=http://localhost:8001
AI_SERVICE_API_KEY=